# Copiá este archivo como .env (no se sube a git) y completalo.

# ─── Cloudflare R2 (para `npm run upload`) ───
# Dashboard de Cloudflare → R2 → "Manage R2 API Tokens" → Create API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media

# ─── URL pública del bucket (la usa la web) ───
# R2 → bucket → Settings → Public access → r2.dev subdomain (o un dominio propio)
# También hay que cargarla en Vercel → Settings → Environment Variables.
VITE_MEDIA_BASE_URL=
